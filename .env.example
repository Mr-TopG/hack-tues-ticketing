# -----------------------------------------------------------------------------

# Django

# -----------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings

# Replace this with a long, randomly generated value.

DJANGO_SECRET_KEY=replace-with-a-secure-random-secret

DJANGO_DEBUG=true

# Comma-separated hostnames without schemes.

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins including the scheme.

DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Public URL used when generating links in emails.

APP_BASE_URL=http://localhost

# Development listener. Use 0.0.0.0 for phone/LAN QR testing.

WEB_HOST_BIND=0.0.0.0
WEB_PORT=8000

# Production process settings (used when DJANGO_DEBUG=false).

WEB_CONCURRENCY=3
WEB_REQUEST_TIMEOUT=30
WEB_GRACEFUL_TIMEOUT=30
WEB_KEEPALIVE=5
WEB_MAX_REQUESTS=1000
WEB_MAX_REQUESTS_JITTER=100
WEB_LOG_LEVEL=info
FORWARDED_ALLOW_IPS=*

# Optional Nginx production profile listener. Use 127.0.0.1 when a
# cloudflared connector on this VM routes to http://127.0.0.1:8080.

HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# -----------------------------------------------------------------------------

# PostgreSQL

# -----------------------------------------------------------------------------

POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=replace-with-a-secure-database-password

DATABASE_URL=postgresql://ticketing:replace-with-a-secure-database-password@postgres:5432/ticketing

# -----------------------------------------------------------------------------

# Redis

# -----------------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0

# Separate Redis database numbers are used to keep responsibilities isolated.

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/3

# -----------------------------------------------------------------------------

# Celery

# -----------------------------------------------------------------------------

CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false

# -----------------------------------------------------------------------------

# Email

# -----------------------------------------------------------------------------

# Development default: emails are printed in the container logs.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

DEFAULT_FROM_EMAIL=Hack TUES Tickets <tickets@example.com>
SERVER_EMAIL=server@example.com

# SMTP settings are used when EMAIL_BACKEND is changed to:

# django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# -----------------------------------------------------------------------------

# File storage

# -----------------------------------------------------------------------------

# Supported initial value: filesystem

# A future cloud deployment may use an object-storage backend.

STORAGE_BACKEND=filesystem

MEDIA_ROOT=/app/media
MEDIA_URL=/media/
PRIVATE_MEDIA_ROOT=/app/private-media
TICKET_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
TICKET_PDF_BOLD_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

STATIC_ROOT=/app/staticfiles
STATIC_URL=/static/

# Maximum generated ticket-file size in bytes.

MAX_TICKET_FILE_SIZE=5242880

# -----------------------------------------------------------------------------

# Security

# -----------------------------------------------------------------------------

SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Trust the reverse proxy's forwarded HTTPS header.

SECURE_PROXY_SSL_HEADER_ENABLED=false

# -----------------------------------------------------------------------------

# Application behavior

# -----------------------------------------------------------------------------

DEFAULT_TICKET_RESERVATION_MINUTES=10
MAX_TICKETS_PER_USER=1

# Ticket PDF generation and delivery retries.

TICKET_GENERATION_MAX_RETRIES=5
EMAIL_DELIVERY_MAX_RETRIES=5
TICKET_EMAIL_RESEND_COOLDOWN_SECONDS=60
TICKET_EMAIL_STALE_AFTER_SECONDS=900

# -----------------------------------------------------------------------------

# Logging

# -----------------------------------------------------------------------------

DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------

# Optional monitoring

# -----------------------------------------------------------------------------

SENTRY_DSN=


# Email verification token lifetime in seconds
EMAIL_VERIFICATION_MAX_AGE=86400

ACCOUNT_EMAIL_CONFIRMATION_EXPIRE_DAYS=1

# Google OAuth web client. Configure both values or leave both empty.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
